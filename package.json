      "icon": "Cloud"
    },
    "server": "./server.ts",
    "skills": [
      "skills"
    ],
    "app": "./app.tsx"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.104",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.5.0",
    "eslint": "^10.14.0",
    "hono": "^4.11.9",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1"
  },
  "description": "Run bb threads inside Ona environments (devboxes) over SSH.",
  "scripts": {
    "check": "npm run typecheck && npm run lint && prettier --check . && npm test",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --test-timeout=60000 test/*.test.ts"
  }
