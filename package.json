{
  "name": "bb-plugin-ona",
  "version": "0.3.5",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bb": ">=0.48.1",
    "bbPluginSdk": ">=0.6.104",
    "node": ">=22.8"
  },
  "bb": {
    "name": "Ona devboxes [Experimental]",
